---
import SiteFooterView from '@flaviocodes/sfoglia-ui/components/SiteFooter.vue';

import type { Locale } from '../i18n/config';
import { getTranslations } from '../i18n/t';
import { site, telHref } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const locality = [site.postalCode, site.city].filter(Boolean).join(' ');
---

<SiteFooterView
  businessName={site.businessName}
  legalName={site.legalName}
  street={site.street}
  locality={locality}
  phone={site.phone}
  phoneHref={site.phone ? telHref(site.phone) : undefined}
  email={site.email}
  socials={site.socials}
  socialLabel={t('footer.social')}
  legalLinks={[
    { href: `/${locale}/impressum/`, label: t('footer.legal') },
    { href: `/${locale}/datenschutz/`, label: t('footer.privacy') },
  ]}
  legalLabel={t('footer.legal')}
  rights={t('footer.rights')}
  year={new Date().getFullYear()}
/>
