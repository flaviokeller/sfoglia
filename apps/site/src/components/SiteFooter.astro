---
import type { Locale } from '../i18n/config';
import { getTranslations } from '../i18n/t';
import { site, telHref } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();
const locality = [site.postalCode, site.city].filter(Boolean).join(' ');
// A half-filled entry in the editor would otherwise render as a dead icon.
const socials = site.socials.filter((social) => social.href);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__block">
      <p class="site-footer__brand">{site.businessName}</p>
      {
        (site.street || locality) && (
          <address class="site-footer__address">
            {site.street}
            {site.street && locality && <br />}
            {locality}
          </address>
        )
      }
    </div>

    {
      (site.phone || site.email) && (
        <div class="site-footer__block">
          {site.phone && <a class="link" href={telHref(site.phone)}>{site.phone}</a>}
          {site.email && <a class="link" href={`mailto:${site.email}`}>{site.email}</a>}
        </div>
      )
    }

    {
      socials.length > 0 && (
        <nav class="site-footer__block site-footer__socials" aria-label={t('footer.social')}>
          {socials.map((social) => (
            <a class="site-footer__social-link" href={social.href} aria-label={social.label || social.href}>
              {social.icon === 'instagram' ? (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
                </svg>
              ) : social.icon === 'youtube' ? (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="20" height="14" rx="4" />
                  <path d="M10 9l5 3-5 3z" fill="currentColor" stroke="none" />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1" />
                  <path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" />
                </svg>
              )}
            </a>
          ))}
        </nav>
      )
    }

    <nav class="site-footer__block" aria-label={t('footer.legal')}>
      <a class="link" href={`/${locale}/impressum/`}>{t('footer.legal')}</a>
      <a class="link" href={`/${locale}/datenschutz/`}>{t('footer.privacy')}</a>
    </nav>
  </div>

  <div class="container site-footer__meta">
    <small>&copy; {year} {site.legalName || site.businessName}. {t('footer.rights')}</small>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-section);
    padding-block: var(--space-2xl) var(--space-lg);
    background-color: var(--color-surface-sunken);
    border-block-start: 1px solid var(--color-border);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-xl);
  }

  .site-footer__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: start;
  }

  .site-footer__socials {
    flex-direction: row;
    gap: var(--space-sm);
  }

  .site-footer__social-link {
    color: var(--color-text-subtle);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-footer__social-link:hover {
    color: var(--color-accent-text);
  }

  .site-footer__brand {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
  }

  .site-footer__address {
    font-style: normal;
    color: var(--color-text-muted);
  }

  .site-footer__meta {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
    color: var(--color-text-subtle);
  }
</style>
