---
import type { Locale } from '../i18n/config';
import { getTranslations } from '../i18n/t';
import { site, telHref } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();
const locality = [site.postalCode, site.city].filter(Boolean).join(' ');
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__block">
      <p class="site-footer__brand">{site.businessName}</p>
      {
        (site.street || locality) && (
          <address class="site-footer__address">
            {site.street}
            {site.street && locality && <br />}
            {locality}
          </address>
        )
      }
    </div>

    {
      (site.phone || site.email) && (
        <div class="site-footer__block">
          {site.phone && <a class="link" href={telHref(site.phone)}>{site.phone}</a>}
          {site.email && <a class="link" href={`mailto:${site.email}`}>{site.email}</a>}
        </div>
      )
    }

    <nav class="site-footer__block" aria-label={t('footer.legal')}>
      <a class="link" href={`/${locale}/impressum/`}>{t('footer.legal')}</a>
      <a class="link" href={`/${locale}/datenschutz/`}>{t('footer.privacy')}</a>
    </nav>
  </div>

  <div class="container site-footer__meta">
    <small>&copy; {year} {site.legalName || site.businessName}. {t('footer.rights')}</small>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-section);
    padding-block: var(--space-2xl) var(--space-lg);
    background-color: var(--color-surface-sunken);
    border-block-start: 1px solid var(--color-border);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-xl);
  }

  .site-footer__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: start;
  }

  .site-footer__brand {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
  }

  .site-footer__address {
    font-style: normal;
    color: var(--color-text-muted);
  }

  .site-footer__meta {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
    color: var(--color-text-subtle);
  }
</style>
