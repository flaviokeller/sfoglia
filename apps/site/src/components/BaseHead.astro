---
import { LOCALES, type Locale, withLocale } from '../i18n/config';
import { site, structuredData } from '../data/site';
import { jsonLd } from '../lib/json-ld';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  ogImage?: string | undefined;
  noindex?: boolean;
}

const { title, description, locale, ogImage, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;

// hreflang alternates. Search engines need every locale listed on every page,
// including the page pointing at itself.
const alternates = LOCALES.map((code) => ({
  code,
  href: new URL(withLocale(Astro.url.pathname, code), Astro.site).href,
}));

/**
 * Structured data — the single highest-value SEO item for a small site: for a
 * business it puts opening hours and the address into the Google side panel.
 * The type comes from `schemaType` in site.json (see data/site.ts).
 */
const schema = structuredData(description, Astro.site?.href);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
<link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content={site.businessName} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />

<script type="application/ld+json" set:html={jsonLd(schema)} is:inline />

{/*
  Without JavaScript the Vue islands never hydrate, so their server-rendered
  closed states would be dead ends: answers hidden for good, and on phones no
  nav at all behind a toggle that does nothing. Fall back to the static layout.
*/}
<noscript>
  <style>
    .accordion__panel[hidden] {
      display: block;
    }

    /* Doubled-up selectors outrank the drawer's media query without !important. */
    .accordion .accordion__icon,
    .nav .nav__toggle {
      display: none;
    }

    .nav .nav__bar {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--space-md);
    }

    /* Three classes deep to outrank Astro's scoped `.class[data-astro-cid]`. */
    .site-header .site-header__inner,
    .site-header .site-header__inner .site-header__right {
      flex-wrap: wrap;
      flex-shrink: 1;
      min-inline-size: 0;
    }
  </style>
</noscript>
