---
import SiteHeaderView from '@flaviocodes/sfoglia-ui/components/SiteHeader.vue';

import { LOCALE_NAMES, LOCALES, type Locale, withLocale } from '../i18n/config';
import { getTranslations } from '../i18n/t';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  /**
   * Brand and language switch only, no page nav — for a coming-soon page or
   * any page whose nav targets do not exist yet.
   */
  minimal?: boolean;
}

const { locale, minimal = false } = Astro.props;
const t = getTranslations(locale);
const path = Astro.url.pathname;

const links = [
  { href: `/${locale}/`, label: t('nav.home') },
  { href: `/${locale}/leistungen/`, label: t('nav.services') },
  { href: `/${locale}/team/`, label: t('nav.team') },
  { href: `/${locale}/kontakt/`, label: t('nav.contact') },
];

const languages = LOCALES.map((code) => ({
  code,
  name: LOCALE_NAMES[code],
  href: withLocale(path, code),
  current: code === locale,
}));
---

{/*
  client:load rather than client:visible — the header is above the fold, and
  a hamburger that does nothing for the first moments is worse than the few
  extra kilobytes of eager hydration.
*/}
<SiteHeaderView
  client:load
  businessName={site.businessName}
  homeHref={`/${locale}/`}
  links={links}
  current={path}
  languages={languages}
  languageSwitchLabel={t('language.switch')}
  menuLabel={t('nav.menu')}
  closeLabel={t('nav.close')}
  minimal={minimal}
/>
