---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, type Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/t';
import { site, telHref } from '../../data/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getTranslations(locale);
const locality = [site.postalCode, site.city].filter(Boolean).join(' ');

/**
 * Legal copy per locale. Kept here rather than in i18n/*.json: it is prose that
 * must stay accurate to this stack, not UI copy. `satisfies` makes a newly
 * added locale a type error until its copy exists, instead of a silent
 * fallback to another language.
 */
const copy = {
  de: {
    responsible: 'Verantwortlich',
    uidTitle: 'Handelsregister / UID',
    disclaimerTitle: 'Haftungsausschluss',
    disclaimer:
      'Die Inhalte dieser Website werden mit Sorgfalt erstellt. Für die Richtigkeit, Vollständigkeit und Aktualität kann jedoch keine Gewähr übernommen werden.',
  },
  en: {
    responsible: 'Responsible',
    uidTitle: 'Commercial register / UID',
    disclaimerTitle: 'Disclaimer',
    disclaimer:
      'The content of this website is prepared with care. No guarantee is given as to its accuracy, completeness or timeliness.',
  },
} satisfies Record<Locale, Record<string, string>>;

const c = copy[locale];
---

<BaseLayout title={`${t('footer.legal')} — ${site.businessName}`} description={t('footer.legal')} locale={locale}>
  <section class="section">
    <div class="container prose stack">
      <h1 class="heading-1">{t('footer.legal')}</h1>

      <!--
        SETUP: have the client confirm these details before launch. See
        docs/02-legal-privacy-checklist.md — an Impressum is expected for any
        commercially operated Swiss site.
      -->
      <h2 class="heading-3">{c.responsible}</h2>
      <p>
        {site.legalName || site.businessName}
        {site.street && <><br />{site.street}</>}
        {locality && <><br />{locality}</>}
      </p>

      <p>
        {site.email && <a class="link" href={`mailto:${site.email}`}>{site.email}</a>}
        {site.email && site.phone && <br />}
        {site.phone && <a class="link" href={telHref(site.phone)}>{site.phone}</a>}
      </p>

      {/* Only for clients in the Handelsregister. An invented UID is worse than none. */}
      {
        site.uid && (
          <>
            <h2 class="heading-3">{c.uidTitle}</h2>
            <p>{site.uid}</p>
          </>
        )
      }

      <h2 class="heading-3">{c.disclaimerTitle}</h2>
      <p>{c.disclaimer}</p>
    </div>
  </section>
</BaseLayout>
