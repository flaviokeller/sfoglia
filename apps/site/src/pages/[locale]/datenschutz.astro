---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, type Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/t';
import { site } from '../../data/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getTranslations(locale);
const analyticsEnabled = Boolean(site.analytics.cloudflareToken);
const controller = [
  site.legalName || site.businessName,
  site.street,
  [site.postalCode, site.city].filter(Boolean).join(' '),
]
  .filter(Boolean)
  .join(', ');

/**
 * Legal copy per locale. Kept here rather than in i18n/*.json: it is prose that
 * must stay accurate to how THIS stack behaves (docs/02-legal-privacy-checklist.md),
 * not UI copy. `satisfies` makes a newly added locale a type error until its
 * copy exists, instead of a silent fallback to another language.
 */
const copy = {
  de: {
    controller: 'Verantwortliche Stelle',
    cookiesTitle: 'Cookies',
    cookies:
      'Diese Website setzt keine Cookies und verwendet keine Tracking-Technologien, die eine Einwilligung erfordern.',
    fontsTitle: 'Schriftarten',
    fonts:
      'Alle Schriftarten werden von unserem eigenen Server ausgeliefert. Es werden keine Daten an Google Fonts oder ein anderes CDN übertragen.',
    formTitle: 'Kontaktformular',
    form: 'Wenn Sie uns über das Kontaktformular schreiben, werden Name, E-Mail-Adresse und Nachricht von unserem Hosting-Anbieter Cloudflare (Cloudflare, Inc., USA) entgegengenommen und über den E-Mail-Versanddienst Lettermint (Niederlande, Datenverarbeitung ausschliesslich in der EU) per E-Mail an uns zugestellt. Lettermint löscht die Nachricht nach 28 Tagen. Wir verwenden Ihre Angaben ausschliesslich zur Beantwortung Ihrer Anfrage. Anfragen werden nach 90 Tagen gelöscht.',
    mailtoTitle: 'Kontakt per E-Mail',
    mailto:
      'Wenn Sie uns per E-Mail schreiben, verwenden wir Ihre Angaben ausschliesslich zur Beantwortung Ihrer Anfrage. Anfragen werden nach 90 Tagen gelöscht.',
    hostingTitle: 'Hosting',
    hosting:
      'Diese Website wird bei Cloudflare (Cloudflare, Inc., USA) gehostet. Cloudflare verarbeitet Server-Logdaten (u.a. IP-Adresse, Zeitpunkt, abgerufene Seite) zur Sicherstellung des Betriebs und zum Schutz vor Angriffen.',
    analyticsTitle: 'Statistik',
    analytics:
      'Wir verwenden Cloudflare Web Analytics. Dabei werden keine Cookies gesetzt und keine Besucherinnen und Besucher über Websites hinweg verfolgt.',
    rightsTitle: 'Ihre Rechte',
    rights:
      'Sie haben das Recht auf Auskunft, Berichtigung und Löschung Ihrer Daten. Melden Sie sich dazu unter der oben genannten Adresse.',
  },
  en: {
    controller: 'Data controller',
    cookiesTitle: 'Cookies',
    cookies: 'This website sets no cookies and uses no tracking technologies that would require consent.',
    fontsTitle: 'Fonts',
    fonts: 'All fonts are served from our own server. No data is transmitted to Google Fonts or any other CDN.',
    formTitle: 'Contact form',
    form: 'If you write to us through the contact form, your name, email address and message are received by our hosting provider Cloudflare (Cloudflare, Inc., USA) and delivered to us by email through the email service Lettermint (Netherlands, data processed only in the EU). Lettermint deletes the message after 28 days. We use this information solely to answer your enquiry. Enquiries are deleted after 90 days.',
    mailtoTitle: 'Contact by email',
    mailto: 'If you email us, we use your details solely to answer your enquiry. Enquiries are deleted after 90 days.',
    hostingTitle: 'Hosting',
    hosting:
      'This website is hosted by Cloudflare (Cloudflare, Inc., USA). Cloudflare processes server log data (including IP address, timestamp and requested page) to keep the service running and protect it against attacks.',
    analyticsTitle: 'Analytics',
    analytics: 'We use Cloudflare Web Analytics. It sets no cookies and does not track visitors across websites.',
    rightsTitle: 'Your rights',
    rights: 'You have the right to access, correct and delete your data. Please contact us at the address above.',
  },
} satisfies Record<Locale, Record<string, string>>;

const c = copy[locale];
---

<BaseLayout title={`${t('footer.privacy')} — ${site.businessName}`} description={t('footer.privacy')} locale={locale}>
  <section class="section">
    <div class="container prose stack">
      <h1 class="heading-1">{t('footer.privacy')}</h1>

      <!--
        SETUP: this template reflects how THIS stack actually behaves. If you add
        a third-party embed (maps, video, booking widget, chat), you must extend
        this page — see docs/02-legal-privacy-checklist.md. The 90-day deletion
        is a promise the client has to keep: confirm it with them.
      -->

      <h2 class="heading-3">{c.controller}</h2>
      <p>{controller}</p>

      <h2 class="heading-3">{c.cookiesTitle}</h2>
      <p>{c.cookies}</p>

      <h2 class="heading-3">{c.fontsTitle}</h2>
      <p>{c.fonts}</p>

      <h2 class="heading-3">{site.contactMode === 'form' ? c.formTitle : c.mailtoTitle}</h2>
      <p>{site.contactMode === 'form' ? c.form : c.mailto}</p>

      <h2 class="heading-3">{c.hostingTitle}</h2>
      <p>{c.hosting}</p>

      {
        analyticsEnabled && (
          <>
            <h2 class="heading-3">{c.analyticsTitle}</h2>
            <p>{c.analytics}</p>
          </>
        )
      }

      <h2 class="heading-3">{c.rightsTitle}</h2>
      <p>{c.rights}</p>
    </div>
  </section>
</BaseLayout>
