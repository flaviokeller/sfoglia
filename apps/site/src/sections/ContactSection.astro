---
import ContactSectionView from '@flaviocodes/sfoglia-ui/components/ContactSection.vue';

import { site } from '../data/site';
import type { Locale } from '../i18n/config';
import { contactFormLabels, getTranslations } from '../i18n/t';

export interface Props {
  locale: Locale;
  /** h1 when the section is the page itself (Kontakt), h2 inside a longer page. */
  as?: 'h1' | 'h2';
}

const { locale, as: Heading = 'h2' } = Astro.props;
const t = getTranslations(locale);
---

{
  site.contactMode === 'mailto' ? (
    <ContactSectionView
      title={t('contact.title')}
      as={Heading}
      mailto={site.email}
      mailtoLabel={t('contact.mailto')}
    />
  ) : (
    <ContactSectionView
      client:visible
      title={t('contact.title')}
      as={Heading}
      successUrl={`/${locale}/danke/`}
      labels={contactFormLabels(locale)}
    />
  )
}
