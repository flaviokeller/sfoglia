---
import StatsStrip from '@flaviocodes/sfoglia-ui/components/StatsStrip.vue';
import { getCollection } from 'astro:content';

import { inLocale } from '../content.config';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  title?: string | undefined;
  surface?: boolean;
}

const { locale, title, surface } = Astro.props;

const stats = (await getCollection('stats', inLocale(locale)))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => ({ value: data.value, label: data.label }));
---

<StatsStrip title={title} surface={surface} stats={stats} />
