---
import OpeningHoursSection from '@flaviocodes/sfoglia-ui/components/OpeningHoursSection.vue';

import type { Locale } from '../i18n/config';
import { getTranslations } from '../i18n/t';
import { DAY_NAMES, site, telHref } from '../data/site';

interface Props {
  locale: Locale;
  surface?: boolean;
}

const { locale, surface = true } = Astro.props;
const t = getTranslations(locale);
const locality = [site.postalCode, site.city].filter(Boolean).join(' ');
---

{/* `live`: "today" must not be computed at build time — a static build would
    freeze it on whatever day the site was deployed. */}
<OpeningHoursSection
  client:visible
  live
  surface={surface}
  title={t('hours.title')}
  street={site.street}
  locality={locality}
  phone={site.phone}
  phoneHref={site.phone ? telHref(site.phone) : undefined}
  mapLink={
    site.mapUrl
      ? { href: site.mapUrl, label: [site.city, t('hours.map')].filter(Boolean).join(' · ') }
      : undefined
  }
  hours={site.openingHours ?? []}
  dayNames={DAY_NAMES[locale]}
  closedLabel={t('hours.closed')}
/>
