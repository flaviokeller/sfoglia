---
import EventsSectionView from '@flaviocodes/sfoglia-ui/components/EventsSection.vue';
import type { EventItem } from '@flaviocodes/sfoglia-ui';

import { INTL_LOCALES, type Locale } from '../i18n/config';
import { getTranslations } from '../i18n/t';

interface Props {
  /** Anchor target, for one-page navigation. */
  id?: string | undefined;
  locale: Locale;
  events: EventItem[];
  surface?: boolean;
}

const { id, locale, events, surface = false } = Astro.props;
const t = getTranslations(locale);

/*
 * "Today" for the server render only. The section gets `live`, so it re-derives
 * today from the visitor's clock on hydration and the upcoming/past split is
 * right on every load, not just as of the last deploy.
 */
const today = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Zurich' });
---

<EventsSectionView
  client:visible
  id={id}
  title={t('events.title')}
  events={events}
  today={today}
  live
  locale={INTL_LOCALES[locale]}
  labels={{ past: t('events.past'), empty: t('events.empty') }}
  surface={surface}
/>
