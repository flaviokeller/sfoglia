---
import HeroSection from '@flaviocodes/sfoglia-ui/components/HeroSection.vue';
import type { ImageMetadata } from 'astro';

import { resolveImage } from '../lib/image';

export interface Props {
  eyebrow?: string | undefined;
  title: string;
  /** h1 by default; drop to h2 when the section appears more than once on a page. */
  as?: 'h1' | 'h2';
  lead?: string | undefined;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  primaryCta?: { href: string; label: string } | undefined;
  secondaryCta?: { href: string; label: string } | undefined;
}

const { eyebrow, title, as, lead, image, imageAlt, primaryCta, secondaryCta } = Astro.props;

const resolved = image
  ? await resolveImage(image, {
      alt: imageAlt,
      widths: [480, 800, 1200],
      sizes: '(width >= 64rem) 45vw, 100vw',
    })
  : undefined;
---

<HeroSection
  eyebrow={eyebrow}
  title={title}
  as={as}
  lead={lead}
  image={resolved}
  primaryCta={primaryCta}
  secondaryCta={secondaryCta}
/>
