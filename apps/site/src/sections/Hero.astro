---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  eyebrow?: string | undefined;
  title: string;
  /**
   * Heading level. Defaults to h1 because the hero is normally the page title —
   * drop to h2 when the section is used more than once on a page (the styleguide
   * does this), so the page keeps exactly one h1.
   */
  as?: 'h1' | 'h2';
  lead?: string | undefined;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  primaryCta?: { href: string; label: string } | undefined;
  secondaryCta?: { href: string; label: string } | undefined;
}

const {
  eyebrow,
  title,
  as: Heading = 'h1',
  lead,
  image,
  imageAlt = '',
  primaryCta,
  secondaryCta,
} = Astro.props;
---

<section class="section hero">
  <div class="container hero__inner" data-with-image={image ? 'true' : 'false'}>
    <div class="hero__content stack">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <Heading class="heading-hero">{title}</Heading>
      {lead && <p class="lead">{lead}</p>}
      {
        (primaryCta || secondaryCta) && (
          <div class="hero__actions">
            {primaryCta && (
              <a class="button button--primary button--lg" href={primaryCta.href}>
                {primaryCta.label}
              </a>
            )}
            {secondaryCta && (
              <a class="button button--secondary button--lg" href={secondaryCta.href}>
                {secondaryCta.label}
              </a>
            )}
          </div>
        )
      }
    </div>

    {
      image && (
        <div class="hero__media">
          {/* Eager + high priority: this is the LCP element, never lazy-load it. */}
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 800, 1200]}
            sizes="(width >= 64rem) 45vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero__inner {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  .hero__inner[data-with-image='true'] {
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
  }

  .hero__content {
    --flow-space: var(--space-md);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-lg);
  }

  .hero__media :global(img) {
    inline-size: 100%;
    border-radius: var(--radius-xl);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
