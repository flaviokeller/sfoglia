---
import TextImageSection from '@flaviocodes/sfoglia-ui/components/TextImageSection.vue';
import type { ImageMetadata } from 'astro';

import { resolveImage } from '../lib/image';

interface Props {
  /** Anchor target, for one-page navigation. */
  id?: string | undefined;
  eyebrow?: string | undefined;
  title: string;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  /** Puts the image first on wide viewports. Ignored on narrow ones. */
  reversed?: boolean;
  surface?: boolean;
}

const { image, imageAlt, ...rest } = Astro.props;

const resolved = image
  ? await resolveImage(image, {
      alt: imageAlt,
      widths: [400, 700, 1000],
      sizes: '(width >= 64rem) 45vw, 100vw',
    })
  : undefined;
---

<TextImageSection {...rest} image={resolved}><slot /></TextImageSection>
