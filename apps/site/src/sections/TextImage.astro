---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string | undefined;
  title: string;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  /** Puts the image first on wide viewports. Ignored on narrow ones. */
  reversed?: boolean;
  surface?: boolean;
}

const { eyebrow, title, image, imageAlt = '', reversed = false, surface = false } = Astro.props;
---

<section class:list={['section', surface && 'section--surface']}>
  <div class="container text-image" data-reversed={reversed ? 'true' : 'false'}>
    <div class="text-image__body stack">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="heading-2">{title}</h2>
      <div class="prose text-muted"><slot /></div>
    </div>

    {
      image && (
        <div class="text-image__media">
          <Image
            src={image}
            alt={imageAlt}
            widths={[400, 700, 1000]}
            sizes="(width >= 64rem) 45vw, 100vw"
            loading="lazy"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .text-image {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-2xl);
    align-items: center;
  }

  .text-image[data-reversed='true'] .text-image__media {
    order: -1;
  }

  /* Reversal only makes sense side-by-side; stacked, text should always lead. */
  @media (width < 48rem) {
    .text-image[data-reversed='true'] .text-image__media {
      order: 0;
    }
  }

  .text-image__media :global(img) {
    inline-size: 100%;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }
</style>
