---
import ServiceGridSection from '@flaviocodes/sfoglia-ui/components/ServiceGrid.vue';
import type { ServiceItem } from '@flaviocodes/sfoglia-ui';

export interface Props {
  /** Anchor target, for one-page navigation. */
  id?: string | undefined;
  eyebrow?: string | undefined;
  title: string;
  /** h1 when the grid is the page itself (Leistungen), h2 as a section of a longer page. */
  as?: 'h1' | 'h2';
  lead?: string | undefined;
  services: ServiceItem[];
  surface?: boolean;
}

const { id, eyebrow, title, as, lead, services, surface } = Astro.props;
---

<ServiceGridSection
  id={id}
  eyebrow={eyebrow}
  title={title}
  as={as}
  lead={lead}
  services={services}
  surface={surface}
/>
