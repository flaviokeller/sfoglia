---
interface Service {
  title: string;
  summary: string;
  href?: string | undefined;
}

export interface Props {
  /** Anchor target, for one-page navigation. */
  id?: string | undefined;
  eyebrow?: string | undefined;
  title: string;
  /** h1 when the grid is the page itself (Leistungen), h2 as a section of a longer page. */
  as?: 'h1' | 'h2';
  lead?: string | undefined;
  services: Service[];
  surface?: boolean;
}

const { id, eyebrow, title, as: Heading = 'h2', lead, services, surface = true } = Astro.props;

// As a section, an empty grid would be a heading over nothing, so it drops out.
// As the page itself it keeps its heading, so the page is never blank.
const visible = services.length > 0 || Heading === 'h1';
---

{visible && (
  <section id={id} class:list={['section', surface && 'section--surface']}>
    <div class="container stack">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <Heading class:list={[Heading === 'h1' ? 'heading-1' : 'heading-2']}>{title}</Heading>
      {lead && <p class="lead">{lead}</p>}

      {services.length > 0 && (
        <ul class="grid grid--auto service-grid" role="list">
          {
            services.map((service: Service) => (
              <li>
                <article class:list={['card', service.href && 'card--interactive']}>
                  <h3 class="heading-4">
                    {service.href ? (
                      <a class="service-grid__link" href={service.href}>
                        {service.title}
                      </a>
                    ) : (
                      service.title
                    )}
                  </h3>
                  <p class="text-muted">{service.summary}</p>
                </article>
              </li>
            ))
          }
        </ul>
      )}
    </div>
  </section>
)}

<style>
  .service-grid {
    margin-block-start: var(--space-xl);
    padding: 0;
  }

  .service-grid > li {
    display: flex;
  }

  .service-grid article {
    inline-size: 100%;
  }

  .service-grid__link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretch the link's hit area over the whole card. */
  .service-grid__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .service-grid article {
    position: relative;
  }
</style>
